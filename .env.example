# TCHATCHA — Variables d'environnement (backend)
# Copier ce fichier en `.env` puis remplacer les valeurs `xxxx`.
# Référence : 17-infrastructure.md, 15-securite.md, 10-blueprint-backend.md

# --- Application ---
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
APP_NAME=tchatcha-api

# --- Base de données (PostgreSQL 16 + PostGIS, docker-compose) ---
DATABASE_URL=postgresql://postgres:[lcNMmiRfNddYCzqq]@db.lscthekvzcljbwxfalnw.supabase.co:5432/postgres
DB_SSL=disabled

# --- Redis (cache, OTP store, anti double-réservation) ---
REDIS_URL=redis://localhost:6379

# --- Auth / sécurité ---
JWT_SECRET=xxxx-change-moi-en-64-caracteres-minimum
JWT_REFRESH_SECRET=xxxx-change-moi-aussi
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=30d
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5

# --- Stockage S3 (MinIO en dev, R2 en prod) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=xxxx
S3_BUCKET_PUBLIC=tchatcha
S3_BUCKET_PRIVATE=tchatcha-private
S3_FORCE_PATH_STYLE=true
S3_PRESIGN_TTL_SECONDS=900
# URL publique du bucket (MinIO : {endpoint}/{bucket} ; R2 : domaine CDN)
S3_PUBLIC_URL_BASE=http://localhost:9000/tchatcha

# --- SMS / OTP provider (MTN MoMo, Moov — adapter libs/sms) ---
SMS_PROVIDER=xxxx
SMS_API_KEY=xxxx
SMS_SENDER=TCHATCHA

# --- Notifications push (FCM) ---
FCM_SERVICE_ACCOUNT_PATH=xxxx

# --- Géolocalisation (OSM / Nominatim) ---
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org

# --- Monitoring / observabilité (16-observabilite.md) ---
OTEL_ENDPOINT=xxxx
LOG_LEVEL=info

# --- CORS (clients web autorisés) ---
CORS_ORIGINS=http://localhost:3000