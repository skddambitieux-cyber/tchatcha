{
  "name": "@org/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "migration:show": "cross-env TS_NODE_PROJECT=apps/api/tsconfig.migrations.json typeorm-ts-node-commonjs migration:show -d apps/api/src/database/datasource.ts",
    "migration:run": "cross-env TS_NODE_PROJECT=apps/api/tsconfig.migrations.json typeorm-ts-node-commonjs migration:run -d apps/api/src/database/datasource.ts",
    "migration:revert": "cross-env TS_NODE_PROJECT=apps/api/tsconfig.migrations.json typeorm-ts-node-commonjs migration:revert -d apps/api/src/database/datasource.ts",
    "migration:generate": "cross-env TS_NODE_PROJECT=apps/api/tsconfig.migrations.json typeorm-ts-node-commonjs migration:generate apps/api/src/database/migrations/NewMigration -d apps/api/src/database/datasource.ts"
  },
  "private": true,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.28",
    "@nx/eslint": "23.1.0",
    "@nx/eslint-plugin": "23.1.0",
    "@nx/jest": "^23.1.0",
    "@nx/js": "23.1.0",
    "@nx/nest": "^23.1.1",
    "@nx/node": "^23.1.1",
    "@nx/vite": "23.1.0",
    "@nx/vitest": "23.1.0",
    "@nx/web": "23.1.0",
    "@nx/webpack": "^23.1.0",
    "@swc/core": "^1.15.47",
    "@swc/helpers": "~0.5.18",
    "@swc/jest": "^0.2.39",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/node": "24.13.3",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "~4.1.10",
    "@vitest/ui": "~4.1.10",
    "cross-env": "^10.1.0",
    "eslint": "~10.6.0",
    "jest": "^30.4.2",
    "jiti": "2.4.2",
    "jsonc-eslint-parser": "^2.1.0",
    "nx": "23.1.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.63.0",
    "verdaccio": "6.4.0",
    "vite": "^8.1.4",
    "vitest": "~4.1.10",
    "webpack": "^5.101.3",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^5.2.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "nx": {
    "includedScripts": [],
    "targets": {
      "local-registry": {
        "executor": "@nx/js:verdaccio",
        "options": {
          "port": 4873,
          "config": ".verdaccio/config.yml",
          "storage": "tmp/local-registry/storage"
        }
      }
    }
  },
